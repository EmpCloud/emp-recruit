# =============================================================================
# EMP RECRUIT — Environment
# Copy to .env and fill in. The candidate portal + core app work with just the
# DB/JWT block. The integration blocks below are OPTIONAL — each feature
# degrades gracefully when its key is absent (documented per block).
# =============================================================================

# --- Core (required) ---------------------------------------------------------
NODE_ENV=development
PORT=4500
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=emp_recruit

# Shared with EmpCloud master DB (users/orgs). Falls back to DB_* if unset.
EMPCLOUD_DB_HOST=localhost
EMPCLOUD_DB_PORT=3306
EMPCLOUD_DB_USER=root
EMPCLOUD_DB_PASSWORD=
EMPCLOUD_DB_NAME=empcloud

JWT_SECRET=change-this-in-production
JWT_ACCESS_EXPIRY=7d

CORS_ORIGIN=http://localhost:5179

# Public URLs used to build OAuth redirect URIs, webhook URLs, and candidate
# apply links. Set these to your real hostnames in prod.
PUBLIC_API_URL=http://localhost:4500   # base URL of THIS server (for OAuth callbacks + webhooks)
PUBLIC_APP_URL=http://localhost:5179   # base URL of the recruiter/candidate SPA

# --- Email (OTP + notifications) --------------------------------------------
# Candidate OTP login emails go through here. In development, if SMTP isn't
# reachable, the OTP request response includes a `dev_code` so you can test.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
[email protected]

# =============================================================================
# AI (resume parsing/scoring + interview evaluation) — provider-agnostic.
# Works with ANY of the LLMs below. Set AI_PROVIDER + the matching key. If none
# is set, resume scoring falls back to a keyword heuristic (feature still works,
# just no semantic understanding — e.g. it won't infer "JavaScript" from a
# "Node.js developer"). Verify at:  GET /api/v1/scoring/ai-status
#   (or POST /api/v1/scoring/ai-test to send a live probe with your key).
# Optional AI_MODEL overrides the per-provider default shown in brackets.
# -----------------------------------------------------------------------------
# Pick ONE provider:
#
#   OpenAI:            AI_PROVIDER=openai     OPENAI_API_KEY=sk-...        [gpt-4o-mini]
#   Anthropic Claude:  AI_PROVIDER=anthropic  ANTHROPIC_API_KEY=sk-ant-.. [claude-sonnet-5]
#   Google Gemini:     AI_PROVIDER=gemini     GEMINI_API_KEY=...          [gemini-2.0-flash]
#   OpenAI-compatible: AI_PROVIDER=compatible OPENAI_API_KEY=...  OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                      (Groq, OpenRouter, Together, Ollama, LM Studio, vLLM, …)
#
# If AI_PROVIDER is omitted, the first key present wins (Anthropic → OpenAI → Gemini).
# =============================================================================
AI_PROVIDER=
AI_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=

# =============================================================================
# MEETING OAUTH — auto-create Meet / Teams / Zoom links on interview schedule.
# Recruiters connect via "Sign in with X" (Settings → Integrations). Set the
# client id/secret for each provider you want to offer. Providers without keys
# simply don't appear as connectable. Register the OAuth redirect URI as:
#   {PUBLIC_API_URL}/api/v1/meetings/oauth/{provider}/callback
# =============================================================================
# Google Meet (Google Cloud Console → OAuth client, enable Calendar API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Teams (Azure AD app registration; may need admin consent)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Zoom (Zoom Marketplace → OAuth app)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# =============================================================================
# AI INTERVIEW NOTETAKER — bot joins the call, records, transcribes.
# Recall.ai is the reference vendor (supports Meet/Teams/Zoom bot-join). Without
# this key, the notetaker "Send bot" button is disabled but recruiters can still
# paste a transcript for an AI evaluation.
# The vendor posts transcript events to: {PUBLIC_API_URL}/api/v1/notetaker/webhook
# =============================================================================
RECALL_API_KEY=
RECALL_REGION=us-east-1

# =============================================================================
# JOB DISTRIBUTION — external boards.
# Naukri = "assisted" (no key needed; opens a pre-filled post form).
# LinkedIn / Indeed require partner-program approval + credentials, added per-org
# in the app (portal_credentials), NOT here. Apna has no public posting API.
# =============================================================================
